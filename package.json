{
  "name": "action-repository-dispatch",
  "version": "2.1.0",
  "description": "Send repository_dispatch events with custom payloads",
  "main": "dist/index.js",
  "imports": {
    "#/*": "./src/*"
  },
  "author": {
    "name": "Tony DBR",
    "email": "tonyblast@gmail.com"
  },
  "license": "MIT",
  "repository": "git@github.com:iniva/action-repository-dispatch.git",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build dist/index.js -o dist",
    "test:typecheck": "tsc --noEmit",
    "test:format": "biome format .",
    "test:format:fix": "biome format --write .",
    "test:lint": "biome ci .",
    "test:lint:fix": "biome check --write .",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "remove": "^0.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@vercel/ncc": "^0.38.4",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nock": "^14.0.14",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "."
    ],
    "modulePaths": [
      "<rootDir>/src/"
    ],
    "testMatch": [
      "**/test/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "reporters": [
      [
        "default",
        {
          "summaryThreshold": 1
        }
      ]
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#/(.*)$": "<rootDir>/src/$1"
    }
  }
}
